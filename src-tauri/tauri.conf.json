{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RatAMP",
  "version": "0.1.0",
  "identifier": "com.sebim.spotify-tauri-test",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RatAMP",
        "width": 400,
        "height": 740,
        "minWidth": 340,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["spotify-tauri-test"]
      }
    }
  }
}
